# ==========================================================
# Argus · 多智能体协同深度研究系统 —— 环境变量样例
# 复制为 .env 后按需修改；不要提交真实 key
# ==========================================================

# ---------- LLM 提供方 ----------
# 可选：mock | deepseek | qwen | zhipu | openai
# mock = 本地确定性替身，无需任何 key，用于跑通流程与跑测试
ARGUS_LLM_PROVIDER=mock
ARGUS_LLM_API_KEY=
# 留空则使用 src/llm.py 中各 provider 的默认地址与默认模型
ARGUS_LLM_BASE_URL=
ARGUS_LLM_MODEL=
ARGUS_TEMPERATURE=0.2
ARGUS_MAX_TOKENS=2048
ARGUS_REQUEST_TIMEOUT=60

# ---------- 编排参数 ----------
# Supervisor 单次最多拆解出的子问题数（Researcher 串行逐个处理，非并行）
ARGUS_MAX_PLAN_ITEMS=4
# Critic 判定不通过时，允许返工的最大轮数（自纠错预算）
ARGUS_MAX_CRITIC_ROUNDS=2
# 单个子问题最多调用工具的次数
ARGUS_MAX_TOOL_CALLS=3

# ---------- 工具与检索 ----------
ARGUS_ENABLE_WEB_SEARCH=true
ARGUS_ENABLE_RAG=true
ARGUS_SEARCH_RESULTS=5
ARGUS_RETRIEVE_TOP_K=4
ARGUS_KB_DIR=./data/sample_kb

# ---------- 记忆 ----------
ARGUS_MEMORY_DIR=./.memory
# 短期记忆超过该字符数即触发摘要压缩
ARGUS_MEMORY_SUMMARY_THRESHOLD=4000
# 长期记忆每用户保留的最大条目数
ARGUS_MEMORY_MAX_ITEMS=200

# ---------- 可观测 ----------
ARGUS_TRACE_DIR=./traces
ARGUS_ENABLE_TRACE=true
# 是否在 trace 中记录完整输入输出（调试用，生产建议关闭）
ARGUS_TRACE_VERBOSE=false
# 接入 LangSmith 云端 trace
ARGUS_LANGSMITH=false
ARGUS_LANGSMITH_PROJECT=argus-research

# ---------- 输出 ----------
ARGUS_REPORT_DIR=./reports
